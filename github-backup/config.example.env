# Copy to config.env and edit. config.env is sourced by github-backup.sh.
# Lock down permissions: chmod 600 config.env

# Personal access token with `repo` and `read:org` scopes.
GITHUB_TOKEN="ghp_replace_me"

# Space-separated list of GitHub orgs and/or users to back up.
GITHUB_ACCOUNTS="stanasiukcom defuseddata marchemycom scrapply"

# Where mirror clones live. One subdirectory per account.
BACKUP_ROOT="/volume1/backups/github"

# Per-run log files are written here and pruned after LOG_RETENTION_DAYS.
LOG_DIR="/volume1/backups/github/logs"
LOG_RETENTION_DAYS="30"

# Filters. Set to "false" to skip the matching repos.
INCLUDE_PRIVATE="true"
INCLUDE_FORKS="true"
INCLUDE_ARCHIVED="true"

# Override binary paths if needed (e.g. Entware-installed jq).
# GIT_BIN="/usr/bin/git"
# CURL_BIN="/usr/bin/curl"
# JQ_BIN="/opt/bin/jq"
